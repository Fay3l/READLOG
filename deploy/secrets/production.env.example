# Modèle des secrets de production (ce fichier-ci n'est PAS chiffré : aucune vraie valeur ici).
#
# Création du vrai fichier, chiffré (depuis la racine du dépôt) :
#   cp deploy/secrets/production.env.example deploy/secrets/production.env
#   (remplis les valeurs)
#   sops encrypt --in-place deploy/secrets/production.env
#
# Modification plus tard : `sops deploy/secrets/production.env`
# (déchiffre dans ton éditeur, rechiffre à l'enregistrement)

# Mot de passe Postgres. ⚠️ Ne plus le changer après le premier déploiement (voir le guide).
DB_PASSWORD=
# Clé de signature des jetons JWT, 32 caractères minimum
SECRET_KEY=
# SMTP pour les codes de vérification (vide = codes seulement dans les logs)
MAIL_SERVER=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Optionnel
GOOGLE_BOOKS_API_KEY=
