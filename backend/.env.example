# Copie ce fichier en .env et remplis les valeurs. Le .env ne doit JAMAIS être commité.

# Postgres : postgresql://utilisateur:motdepasse@hote:5432/readlog
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/readlog

# 32 caractères minimum. Génère-la avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
# Durée de validité du jeton, en minutes (défaut : 7 jours)
ACCESS_TOKEN_EXPIRE=10080

# Origines autorisées pour la version WEB de l'app (séparées par des virgules)
CORS_ORIGINS=http://localhost:8081

# Afficher les requêtes SQL (debug uniquement)
SQL_ECHO=false

# SMTP pour envoyer les codes de vérification (Brevo, Resend, Mailtrap...).
# Laisse vide en local : le code s'affichera dans les logs du serveur.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

GOOGLE_BOOKS_API_KEY=
